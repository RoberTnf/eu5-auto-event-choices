			onclick = "[GetScriptedGui('aes_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('aes_event', MakeScopeFlag(EventWindow.GetEventKey)).AddScope('aes_option', MakeScopeFlag(Concatenate('opt_', Concatenate(AddTextIf(And(EventOption.KeyEndWith('.a'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.6'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_fra_sco.105'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.48'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.49'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.50'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen_tun.1'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_pol.1200'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_por.25'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_swe.43'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_swe_teu.1'), Or(EqualTo_string(EventWindow.GetEventKey, 'hussite_flavor.11'), Or(EqualTo_string(EventWindow.GetEventKey, 'institution_events.81'), Or(EqualTo_string(EventWindow.GetEventKey, 'johan.20'), Or(EqualTo_string(EventWindow.GetEventKey, 'king_in_prussia.5'), Or(EqualTo_string(EventWindow.GetEventKey, 'red_turban_rebellions.104'), Or(EqualTo_string(EventWindow.GetEventKey, 'reform_society.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'succession.5'), EqualTo_string(EventWindow.GetEventKey, 'succession_crisis.7'))))))))))))))))))))), 'a'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.b'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'black_death.1024'), Or(EqualTo_string(EventWindow.GetEventKey, 'castilian_civil_war.1031'), Or(EqualTo_string(EventWindow.GetEventKey, 'castilian_civil_war.1051'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_pol.1200'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_tim.81'), EqualTo_string(EventWindow.GetEventKey, 'unionevents.98