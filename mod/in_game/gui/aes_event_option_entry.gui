template expedition_event_option_entry {
	container = {
		widget = {
			size = { 514 42 }

			expeditions_button = {
				parentanchor = center
				widgetanchor = center
				visible = "[Not(EventOption.IsTooltipEmpty)]"
				using = event_option_entry_button_normal
				size = { 490 36 }
				blockoverride "expeditions_button_hover_size" {
					size = { 514 36 }
				}
				blockoverride "expeditions_button_rest_size" {
					size = { 490 36 }
				}
			}

			expeditions_button = {
				parentanchor = center
				widgetanchor = center
				visible = "[EventOption.IsTooltipEmpty]"
				using = event_option_entry_button_empty_tt
				size = { 490 36 }
				blockoverride "expeditions_button_hover_size" {
