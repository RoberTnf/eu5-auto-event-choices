# Auto Event Choices (generated by scripts/aes-build-gui.py from vanilla eventwindow.gui,
# do not edit by hand). Overrides only these vanilla templates.

template event_option_entry {
	container = {
		button_regular_diamond = {
			visible = "[And(Not(EventOption.IsTooltipEmpty), EventOption.IsHighRisk)]"
			using = event_option_entry_button_normal
			size = { 482 36 }
			blockoverride "button_regular_diamond_texture" {
				using = button_event_special_diamond_texture
			}
		}
		button_regular_diamond = {
			visible = "[And(Not(EventOption.IsTooltipEmpty), Not(EventOption.IsHighRisk))]"
			using = event_option_entry_button_normal
			size = { 482 36 }
		}

		button_regular_diamond = {
			visible = "[EventOption.IsTooltipEmpty]"
			using = event_option_entry_button_empty_tt
			size = { 482 36 }
		}

		# Auto Event Choices (generated by scripts/aes-build-gui.py, do not edit by hand).
		# Must come after the option buttons so it draws on top. Options are identified by their name
		# ending (.a .. .p via EventOption.KeyEndWith); options without one, or sharing it, get no cog.
		# Auto-select: fires once the open event has this option remembered (and automation isn't suspended).
		widget = {
			size = { 0 0 }
			state = {
				name = aes_auto_select
				trigger_when = "[And(Not(EventWindow.IsOptionClicked), GetScriptedGui('aes_should_auto').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('aes_event', MakeScopeFlag(EventWindow.GetEventKey)).AddScope('aes_option', MakeScopeFlag(Concatenate('opt_', Concatenate(AddTextIf(And(EventOption.KeyEndWith('.a'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.6'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_fra_sco.105'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.48'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.49'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.50'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen_tun.1'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_pol.1200'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_por.25'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_swe.43'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_swe_teu.1'), Or(EqualTo_string(EventWindow.GetEventKey, 'hussite_flavor.11'), Or(EqualTo_string(EventWindow.GetEventKey, 'institution_events.81'), Or(EqualTo_string(EventWindow.GetEventKey, 'johan.20'), Or(EqualTo_string(EventWindow.GetEventKey, 'king_in_prussia.5'), Or(EqualTo_string(EventWindow.GetEventKey, 'red_turban_rebellions.104'), Or(EqualTo_string(EventWindow.GetEventKey, 'reform_society.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'succession.5'), EqualTo_string(EventWindow.GetEventKey, 'succession_crisis.7'))))))))))))))))))))), 'a'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.b'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'black_death.1024'), Or(EqualTo_string(EventWindow.GetEventKey, 'castilian_civil_war.1031'), Or(EqualTo_string(EventWindow.GetEventKey, 'castilian_civil_war.1051'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_pol.1200'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_tim.81'), EqualTo_string(EventWindow.GetEventKey, 'unionevents.98'))))))))), 'b'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.c'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'artist_events.48'), EqualTo_string(EventWindow.GetEventKey, 'fate_of_the_phoenix.3')))), 'c'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.d'), Not(EqualTo_string(EventWindow.GetEventKey, 'johan.16'))), 'd'), Concatenate(AddTextIf(EventOption.KeyEndWith('.e'), 'e'), Concatenate(AddTextIf(EventOption.KeyEndWith('.f'), 'f'), Concatenate(AddTextIf(EventOption.KeyEndWith('.g'), 'g'), Concatenate(AddTextIf(EventOption.KeyEndWith('.h'), 'h'), Concatenate(AddTextIf(EventOption.KeyEndWith('.i'), 'i'), Concatenate(AddTextIf(EventOption.KeyEndWith('.j'), 'j'), Concatenate(AddTextIf(EventOption.KeyEndWith('.k'), 'k'), Concatenate(AddTextIf(EventOption.KeyEndWith('.l'), 'l'), Concatenate(AddTextIf(EventOption.KeyEndWith('.m'), 'm'), Concatenate(AddTextIf(EventOption.KeyEndWith('.n'), 'n'), Concatenate(AddTextIf(EventOption.KeyEndWith('.o'), 'o'), AddTextIf(EventOption.KeyEndWith('.p'), 'p'))))))))))))))))))).End))]"
				on_start = "[EventOption.Select]"
			}
		}

		# Cog toggle (vanilla automation cog style): 65% when not remembered; when remembered a larger, glowing,
		# full-opacity cog is drawn over it.
		# Option buttons above are shrunk to 482 px so the cog sits beside them.
		button_automation_shortcut = {
			visible = "[Not(StringIsEmpty(Concatenate(AddTextIf(And(EventOption.KeyEndWith('.a'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.6'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_fra_sco.105'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.48'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.49'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.50'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen_tun.1'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_pol.1200'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_por.25'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_swe.43'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_swe_teu.1'), Or(EqualTo_string(EventWindow.GetEventKey, 'hussite_flavor.11'), Or(EqualTo_string(EventWindow.GetEventKey, 'institution_events.81'), Or(EqualTo_string(EventWindow.GetEventKey, 'johan.20'), Or(EqualTo_string(EventWindow.GetEventKey, 'king_in_prussia.5'), Or(EqualTo_string(EventWindow.GetEventKey, 'red_turban_rebellions.104'), Or(EqualTo_string(EventWindow.GetEventKey, 'reform_society.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'succession.5'), EqualTo_string(EventWindow.GetEventKey, 'succession_crisis.7'))))))))))))))))))))), 'a'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.b'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'black_death.1024'), Or(EqualTo_string(EventWindow.GetEventKey, 'castilian_civil_war.1031'), Or(EqualTo_string(EventWindow.GetEventKey, 'castilian_civil_war.1051'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_pol.1200'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_tim.81'), EqualTo_string(EventWindow.GetEventKey, 'unionevents.98'))))))))), 'b'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.c'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'artist_events.48'), EqualTo_string(EventWindow.GetEventKey, 'fate_of_the_phoenix.3')))), 'c'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.d'), Not(EqualTo_string(EventWindow.GetEventKey, 'johan.16'))), 'd'), Concatenate(AddTextIf(EventOption.KeyEndWith('.e'), 'e'), Concatenate(AddTextIf(EventOption.KeyEndWith('.f'), 'f'), Concatenate(AddTextIf(EventOption.KeyEndWith('.g'), 'g'), Concatenate(AddTextIf(EventOption.KeyEndWith('.h'), 'h'), Concatenate(AddTextIf(EventOption.KeyEndWith('.i'), 'i'), Concatenate(AddTextIf(EventOption.KeyEndWith('.j'), 'j'), Concatenate(AddTextIf(EventOption.KeyEndWith('.k'), 'k'), Concatenate(AddTextIf(EventOption.KeyEndWith('.l'), 'l'), Concatenate(AddTextIf(EventOption.KeyEndWith('.m'), 'm'), Concatenate(AddTextIf(EventOption.KeyEndWith('.n'), 'n'), Concatenate(AddTextIf(EventOption.KeyEndWith('.o'), 'o'), AddTextIf(EventOption.KeyEndWith('.p'), 'p'))))))))))))))))))]"
			position = { 486 5 }
			size = { 26 26 }
			alpha = 0.65
			tooltip = "AES_TOGGLE_TT"
			onclick = "[GetScriptedGui('aes_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('aes_event', MakeScopeFlag(EventWindow.GetEventKey)).AddScope('aes_option', MakeScopeFlag(Concatenate('opt_', Concatenate(AddTextIf(And(EventOption.KeyEndWith('.a'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.6'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_fra_sco.105'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.48'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.49'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.50'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen_tun.1'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_pol.1200'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_por.25'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_swe.43'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_swe_teu.1'), Or(EqualTo_string(EventWindow.GetEventKey, 'hussite_flavor.11'), Or(EqualTo_string(EventWindow.GetEventKey, 'institution_events.81'), Or(EqualTo_string(EventWindow.GetEventKey, 'johan.20'), Or(EqualTo_string(EventWindow.GetEventKey, 'king_in_prussia.5'), Or(EqualTo_string(EventWindow.GetEventKey, 'red_turban_rebellions.104'), Or(EqualTo_string(EventWindow.GetEventKey, 'reform_society.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'succession.5'), EqualTo_string(EventWindow.GetEventKey, 'succession_crisis.7'))))))))))))))))))))), 'a'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.b'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'black_death.1024'), Or(EqualTo_string(EventWindow.GetEventKey, 'castilian_civil_war.1031'), Or(EqualTo_string(EventWindow.GetEventKey, 'castilian_civil_war.1051'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_pol.1200'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_tim.81'), EqualTo_string(EventWindow.GetEventKey, 'unionevents.98'))))))))), 'b'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.c'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'artist_events.48'), EqualTo_string(EventWindow.GetEventKey, 'fate_of_the_phoenix.3')))), 'c'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.d'), Not(EqualTo_string(EventWindow.GetEventKey, 'johan.16'))), 'd'), Concatenate(AddTextIf(EventOption.KeyEndWith('.e'), 'e'), Concatenate(AddTextIf(EventOption.KeyEndWith('.f'), 'f'), Concatenate(AddTextIf(EventOption.KeyEndWith('.g'), 'g'), Concatenate(AddTextIf(EventOption.KeyEndWith('.h'), 'h'), Concatenate(AddTextIf(EventOption.KeyEndWith('.i'), 'i'), Concatenate(AddTextIf(EventOption.KeyEndWith('.j'), 'j'), Concatenate(AddTextIf(EventOption.KeyEndWith('.k'), 'k'), Concatenate(AddTextIf(EventOption.KeyEndWith('.l'), 'l'), Concatenate(AddTextIf(EventOption.KeyEndWith('.m'), 'm'), Concatenate(AddTextIf(EventOption.KeyEndWith('.n'), 'n'), Concatenate(AddTextIf(EventOption.KeyEndWith('.o'), 'o'), AddTextIf(EventOption.KeyEndWith('.p'), 'p'))))))))))))))))))).End)]"
		}

		button_automation_shortcut = {
			visible = "[GetScriptedGui('aes_is_auto').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('aes_event', MakeScopeFlag(EventWindow.GetEventKey)).AddScope('aes_option', MakeScopeFlag(Concatenate('opt_', Concatenate(AddTextIf(And(EventOption.KeyEndWith('.a'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.6'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_fra_sco.105'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.48'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.49'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen.50'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_gen_tun.1'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_pol.1200'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_por.25'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_swe.43'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_swe_teu.1'), Or(EqualTo_string(EventWindow.GetEventKey, 'hussite_flavor.11'), Or(EqualTo_string(EventWindow.GetEventKey, 'institution_events.81'), Or(EqualTo_string(EventWindow.GetEventKey, 'johan.20'), Or(EqualTo_string(EventWindow.GetEventKey, 'king_in_prussia.5'), Or(EqualTo_string(EventWindow.GetEventKey, 'red_turban_rebellions.104'), Or(EqualTo_string(EventWindow.GetEventKey, 'reform_society.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'succession.5'), EqualTo_string(EventWindow.GetEventKey, 'succession_crisis.7'))))))))))))))))))))), 'a'), Concatenate(AddTextIf(And(EventOption.KeyEndWith('.b'), Not(Or(EqualTo_string(EventWindow.GetEventKey, 'black_death.1024'), Or(EqualTo_string(EventWindow.GetEventKey, 'castilian_civil_war.1031'), Or(EqualTo_string(EventWindow.GetEventKey, 'castilian_civil_war.1051'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_ath.3'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_pol.1200'), Or(EqualTo_string(EventWindow.GetEventKey, 'flavor_tim.81'), EqualTo_string(EventWindow.GetEventKey, 'unionevents.9